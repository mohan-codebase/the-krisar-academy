<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Proxy all API requests to the PM2 Node.js server running on port 3005
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^(.*)$ http://127.0.0.1:3005/$1 [P,L]

  # 2. Redirect all other requests to index.html for React Router (Single Page App fallback)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
